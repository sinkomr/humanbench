{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinkomr.github.io/humanbench/schema/brief-v1.json",
  "title": "HumanBench notes for your AI, hb-brief/1",
  "description": "The JSON form of the notes a person pastes into their own AI assistant (Phase AI, ADR A20, R-17.3). It mirrors the text form line for line: template ids, topic ids, typed interests, months and statuses only. It carries no numbers except the months, no scores, estimates, levels or zones, no URLs, and no hidden topic lists. The TypeScript validator web/src/brief/validate.ts mirrors this schema exactly and additionally checks the grammar (known line ids, topic ids, slot values).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "templates", "topics", "groups", "as_of", "revisit", "context", "form", "tier", "mode_default", "length", "lines", "keywords", "generator"],
  "properties": {
    "format": { "const": "hb-brief/1" },
    "templates": { "description": "Template-set release, e.g. 2026.09. A line type's gate status is keyed by its wording version within a release.", "type": "string", "pattern": "^\\d{4}\\.\\d{2}$" },
    "topics": { "description": "Topic vocabulary version, e.g. topics-v1.", "type": "string", "pattern": "^topics-v[0-9]+$" },
    "groups": { "description": "Quant grouping version, e.g. g1.", "type": "string", "pattern": "^g[0-9]+$" },
    "as_of": { "$ref": "#/$defs/month" },
    "revisit": { "$ref": "#/$defs/month" },
    "context": { "enum": ["coding", "learning", "reading", "numbers", "writing", "general"] },
    "form": { "description": "The text form these lines mirror.", "enum": ["short", "long", "skill"] },
    "tier": { "enum": ["T1", "T2"] },
    "mode_default": { "enum": ["do", "learn"] },
    "length": { "enum": ["short", "standard", "detailed"] },
    "lines": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/line" } },
    "keywords": {
      "description": "The control words the notes define and the mode each selects.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z ]{0,20}$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z ]{0,20}$" }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "zone_rule", "param_version"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "zone_rule": { "$ref": "#/$defs/version" },
        "param_version": { "$ref": "#/$defs/version" }
      }
    }
  },
  "$defs": {
    "month": { "description": "YYYY-MM, the only digits a note may contain.", "type": "string", "pattern": "^(?:19|20|21)\\d\\d-(?:0[1-9]|1[0-2])$" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$" },
    "line": {
      "description": "One rendered line: its template id and slot values. `status` appears only on an experimental line; `custom` and `text` only on the person's own line (X1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.]{0,15}$" },
        "topics": { "type": "array", "minItems": 1, "maxItems": 25, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]+/[a-z0-9_]+(?:/[a-z0-9_]+)?$" } },
        "interests": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z' -]{1,23}$" } },
        "text": { "type": "string", "pattern": "^[ -~]{3,200}$" },
        "custom": { "const": true },
        "status": { "const": "experimental" }
      }
    }
  }
}
