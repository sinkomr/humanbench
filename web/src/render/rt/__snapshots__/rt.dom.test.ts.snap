// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RtRenderer > matches its snapshots (intro, choice4 fixation) 1`] = `"<section class="hb-render rt svelte-1kiqgla" aria-labelledby="ID-title"><p class="title svelte-1kiqgla" id="ID-title">One position</p> <p class="hb-instructions">A target will appear in the box. As soon as you see it, press the <kbd translate="no" class="svelte-1kiqgla">Space</kbd> bar<!---->.<!----> Wait for the target: pressing early does not count. First come 3 practice trials, then 30 counted trials.</p> <fieldset class="modes svelte-1kiqgla"><legend>Respond with</legend> <label class="svelte-1kiqgla"><input type="radio" value="keyboard" name="ID-mode"> Keyboard</label> <label class="svelte-1kiqgla"><input type="radio" value="touch" name="ID-mode"> Tap or click</label></fieldset><!----> <button type="button" class="hb-btn hb-primary">Start practice</button><!----> <p class="hb-status" aria-live="polite" tabindex="-1"></p></section>"`;

exports[`RtRenderer > matches its snapshots (intro, choice4 fixation) 2`] = `"<section class="hb-render rt svelte-1kiqgla" aria-labelledby="ID-title"><p class="title svelte-1kiqgla" id="ID-title">Four positions</p> <p class="progress svelte-1kiqgla">Practice <span translate="no">1</span> of <span translate="no">3</span></p> <div role="group" tabindex="-1" class="stage svelte-1kiqgla choice4" aria-label="Reaction stage: press D, F, J or K to match the position of the target"><div class="pads svelte-1kiqgla"><p class="fixation svelte-1kiqgla" aria-hidden="true">+</p> <!----><div class="pad svelte-1kiqgla"></div><!----><div class="pad svelte-1kiqgla"></div><!----><div class="pad svelte-1kiqgla"></div><!----><div class="pad svelte-1kiqgla"></div><!----></div> <div class="keys svelte-1kiqgla" aria-hidden="true"><span>D</span><span>F</span><span>J</span><span>K</span></div><!----></div> <p class="hb-sr-only" aria-live="assertive" aria-atomic="true"></p><!----> <p class="hb-status" aria-live="polite" tabindex="-1"></p></section>"`;
