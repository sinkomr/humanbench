// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SeriesRenderer > matches its snapshot (integer and letter) 1`] = `"<section class="hb-render series svelte-d9h2fg" aria-label="Number or letter sequence"><p class="prompt svelte-d9h2fg">Which number comes next in this sequence?</p> <ol class="terms svelte-d9h2fg" aria-label="Sequence, 6 terms shown, then the missing next number"><li class="term svelte-d9h2fg">824</li><li class="term svelte-d9h2fg">1535</li><li class="term svelte-d9h2fg">832</li><li class="term svelte-d9h2fg">1531</li><li class="term svelte-d9h2fg">840</li><li class="term svelte-d9h2fg">1527</li><!----> <li class="term next svelte-d9h2fg"><span aria-hidden="true">?</span><span class="hb-sr-only">missing next number</span></li></ol> <form class="entry svelte-gutdtb" novalidate=""><label class="label svelte-gutdtb" for="ID-in">Next number</label> <div class="row svelte-gutdtb"><input type="text" autocomplete="off" spellcheck="false" enterkeyhint="done" id="ID-in" class="box svelte-gutdtb" inputmode="decimal" autocapitalize="off" aria-describedby="ID-hint ID-note"> <button type="button" class="hb-btn" aria-label="Change sign" translate="no">±</button><!----> <!----> <button type="submit" class="hb-btn hb-primary">Submit</button></div> <p class="hint svelte-gutdtb" id="ID-hint">Enter a whole number, such as 42 or -7.</p> <p class="hb-note" aria-live="polite" id="ID-note"></p> <p class="hb-status" aria-live="polite"></p></form><!----></section>"`;

exports[`SeriesRenderer > matches its snapshot (integer and letter) 2`] = `"<section class="hb-render series svelte-d9h2fg" aria-label="Number or letter sequence"><p class="prompt svelte-d9h2fg">Which letter comes next in this sequence?</p> <ol class="terms svelte-d9h2fg" aria-label="Sequence, 5 terms shown, then the missing next letter"><li class="term svelte-d9h2fg">N</li><li class="term svelte-d9h2fg">Q</li><li class="term svelte-d9h2fg">T</li><li class="term svelte-d9h2fg">W</li><li class="term svelte-d9h2fg">Z</li><!----> <li class="term next svelte-d9h2fg"><span aria-hidden="true">?</span><span class="hb-sr-only">missing next letter</span></li></ol> <form class="entry svelte-gutdtb" novalidate=""><label class="label svelte-gutdtb" for="ID-in">Next letter</label> <div class="row svelte-gutdtb"><input type="text" autocomplete="off" spellcheck="false" enterkeyhint="done" id="ID-in" class="box svelte-gutdtb letter" inputmode="text" autocapitalize="characters" aria-describedby="ID-hint ID-note"> <!----> <!----> <button type="submit" class="hb-btn hb-primary">Submit</button></div> <p class="hint svelte-gutdtb" id="ID-hint">Enter one letter, A to Z.</p> <p class="hb-note" aria-live="polite" id="ID-note"></p> <p class="hb-status" aria-live="polite"></p></form><!----></section>"`;
