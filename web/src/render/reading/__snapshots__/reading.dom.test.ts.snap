// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ReadingRenderer > matches its snapshot (questions) 1`] = `"<section class="hb-render reading svelte-1vbwfxo" aria-labelledby="ID-title"><p class="title svelte-1vbwfxo" id="ID-title">Reading</p> <form class="questions svelte-1vbwfxo" tabindex="-1" aria-label="Questions about the passage"><fieldset class="question svelte-1vbwfxo"><legend class="svelte-1vbwfxo">1. Which place does the author say was the more terrible sight?</legend> <label class="option svelte-1vbwfxo"><input type="radio" class="svelte-1vbwfxo" value="0" name="ID-q0"> <span>The low island in the bay</span></label><label class="option svelte-1vbwfxo"><input type="radio" class="svelte-1vbwfxo" value="1" name="ID-q0"> <span>Concepcion</span></label><label class="option svelte-1vbwfxo"><input type="radio" class="svelte-1vbwfxo" value="2" name="ID-q0"> <span>The island of Quiriquina</span></label><label class="option svelte-1vbwfxo"><input type="radio" class="svelte-1vbwfxo" value="3" name="ID-q0"> <span>Talcahuano</span></label><!----></fieldset><fieldset class="question svelte-1vbwfxo"><legend class="svelte-1vbwfxo">2. What did the mayor-domo at Quiriquina say was his first notice of the shock?</legend> <label class="option svelte-1vbwfxo"><input type="radio" class="svelte-1vbwfxo" value="0" name="ID-q1"> <span>The great wave rising over the bay</span></label><label class="option svelte-1vbwfxo"><input type="radio" class="svelte-1vbwfxo" value="1" name="ID-q1"> <span>A whole row of houses falling in ruins</span></label><label class="option svelte-1vbwfxo"><input type="radio" class="svelte-1vbwfxo" value="2" name="ID-q1"> <span>Rolling on the ground with his horse</span></label><label class="option svelte-1vbwfxo"><input type="radio" class="svelte-1vbwfxo" value="3" name="ID-q1"> <span>His cows rolling into the sea</span></label><!----></fieldset><fieldset class="question svelte-1vbwfxo"><legend class="svelte-1vbwfxo">3. How many small tremblings were counted within the first twelve days?</legend> <label class="option svelte-1vbwfxo"><input type="radio" class="svelte-1vbwfxo" value="0" name="ID-q2"> <span>About seventy</span></label><label class="option svelte-1vbwfxo"><input type="radio" class="svelte-1vbwfxo" value="1" name="ID-q2"> <span>Somewhat fewer than a hundred</span></label><label class="option svelte-1vbwfxo"><input type="radio" class="svelte-1vbwfxo" value="2" name="ID-q2"> <span>Nearly a thousand</span></label><label class="option svelte-1vbwfxo"><input type="radio" class="svelte-1vbwfxo" value="3" name="ID-q2"> <span>At least three hundred</span></label><!----></fieldset><!----> <p class="hb-status" aria-live="polite"><!----></p><!----> <button type="submit" class="hb-btn hb-primary">Submit answers</button></form><!----></section>"`;
