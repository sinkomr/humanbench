{
  "about": "HumanBench topic taxonomy (Phase AI, ROADMAP A23, AI.3): a controlled vocabulary of content labels for the notes builder and for the item topic tags. A label names a subject, never a level, a score or an ability. Edited in the bank repo (schema/topics-v1.json); the public repo keeps a byte-identical copy (ROADMAP A17, `uv run hb sync topics`). IDs are <axis>/<facet>/<topic> for the finite axes (KST, KHU, KAP, LR, LG, FER), quant/<group> for the six quantitative groups, and other/<topic> for subjects HumanBench does not measure, which a person can still set for themselves. A facet is also an ID (<axis>/<facet>). Retired IDs are never reused: they stay in topics-aliases.json.",
  "topics_version": "topics-v1",
  "group_version": "g1",
  "denied_words": {
    "general_ability": ["abilities", "ability", "aptitude", "attention", "brain", "brains", "capacity", "cognition", "cognitive", "concentration", "genius", "gifted", "intellect", "intellectual", "intelligence", "intelligent", "reasoning", "smart", "talent", "talented"],
    "reading": ["comprehension", "literacy", "literate", "read", "reader", "readers", "reading", "reads", "verbal", "vocabulary"],
    "memory": ["memories", "memorisation", "memorise", "memorization", "memorize", "memory", "mnemonic", "mnemonics", "recall", "remember", "remembering", "retention", "span"],
    "speed": ["fast", "faster", "fastest", "pace", "quick", "quicker", "quickly", "rapid", "reaction", "reflex", "reflexes", "speed", "speeds", "speedy", "timing"],
    "language_background": ["accent", "bilingual", "dialect", "ell", "esl", "first language", "fluency", "fluent", "heritage language", "home language", "immigrant", "language background", "monolingual", "mother tongue", "multilingual", "native", "nonnative", "second language"],
    "school_level": ["advanced", "basic", "basics", "beginner", "beginners", "college", "collegiate", "doctoral", "elementary", "entry level", "expert", "freshman", "grad", "grade", "grade school", "graded", "grades", "grading", "graduate", "graduates", "high school", "intermediate", "intro", "introduction", "introductory", "junior", "kindergarten", "level", "levels", "master", "middle school", "novice", "phd", "postgraduate", "primary school", "remedial", "school", "schooling", "secondary school", "senior", "sophomore", "undergrad", "undergraduate", "university"]
  },
