{
  "name": "humanbench-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.node.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:golden": "sh scripts/sync-golden.sh",
    "dump:families": "tsx scripts/dump-families.ts",
    "dump:coding-scores": "tsx scripts/dump-coding-scores.ts",
    "dump:rt-scores": "tsx scripts/dump-rt-scores.ts",
    "sync:reading-render": "tsx scripts/sync-reading-render.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
